# Phase K.5 — Operations frontend production deploy.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time —
# never put secrets here. Committed deliberately (this repo's .gitignore
# excludes .env* by default but explicitly allows opting in) so the
# production build is reproducible without relying on Vercel dashboard
# state this session has no access to.
NEXT_PUBLIC_OPERATIONS_ENABLED=true
NEXT_PUBLIC_API_BASE_URL=https://api.strongg.us
